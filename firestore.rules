rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read/write their own user document
    match /users/{userId} {
      allow read: if request.auth != null;  // Allow any authenticated user to read any user doc
      allow create, update: if request.auth != null && request.auth.uid == userId;
      // Allow any authenticated user to delete (for admin cleanup) 
      allow delete: if request.auth != null;
    }

    // Allow authenticated users to read/write classes
    match /classes/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow authenticated users to read/write groups
    match /groups/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow anyone to read capoeira_groups, authenticated to write
    match /capoeira_groups/{document=**} {
      allow read: if true;  // Public read
      allow write: if request.auth != null;
    }

    // Allow authenticated users to read/write attendance
    match /attendance/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write schedule templates
    match /schedule_templates/{document=**} {
      allow read, write: if request.auth != null;
    }

    // Allow authenticated users to read/write class instances
    match /class_instances/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write events
    match /events/{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // TEMPORARY FOR DEV: Allow any authenticated user to delete anything
    // WARNING: Remove this rule in production!
    match /{document=**} {
      allow delete: if request.auth != null;
    }
  }
}